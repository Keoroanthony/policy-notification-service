# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
#
# Optional ENV vars:
# ------------------
#   JAVA_HOME - location of a JDK home dir, required when type is JDK
#   MVNW_REPOURL - repo url base for downloading maven distribution
#   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
#   MVNW_VERBOSE - true: enable verbose log; others: silence the output
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != true ] || set -x

# OS specific support.
native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

# set JAVACMD and JAVACCMD
set_java_home() {
  # For Cygwin and MinGW, ensure paths are in Unix format before anything is touched
  if [ -n "${JAVA_HOME-}" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
      # IBM's JDK on AIX uses strange locations for the executables
      JAVACMD="$JAVA_HOME/jre/sh/java"
      JAVACCMD="$JAVA_HOME/jre/sh/javac"
    else
      JAVACMD="$JAVA_HOME/bin/java"
      JAVACCMD="$JAVA_HOME/bin/javac"

      if [ ! -x "$JAVACMD" ] || [ ! -x "$JAVACCMD" ]; then
        echo "The JAVA_HOME environment variable is not defined correctly, so mvnw cannot run." >&2
        echo "JAVA_HOME is set to \"$JAVA_HOME\", but \"\$JAVA_HOME/bin/java\" or \"\$JAVA_HOME/bin/javac\" does not exist." >&2
        return 1
      fi
    fi
  else
    JAVACMD="$(
      'set' +e
      'unset' -f command 2>/dev/null
      'command' -v java
    )" || :
    JAVACCMD="$(
      'set' +e
      'unset' -f command 2>/dev/null
      'command' -v javac
    )" || :

    if [ ! -x "${JAVACMD-}" ] || [ ! -x "${JAVACCMD-}" ]; then
      echo "The java/javac command does not exist in PATH nor is JAVA_HOME set, so mvnw cannot run." >&2
      return 1
    fi
  fi
}

# hash string like Java String::hashCode
hash_string() {
  str="${1:-}" h=0
  while [ -n "$str" ]; do
    char="${str%"${str#?}"}"
    h=$(((h * 31 + $(LC_CTYPE=C printf %d "'$char")) % 4294967296))
    str="${str#?}"
  done
  printf %x\\n $h
}

verbose() { :; }
[ "${MVNW_VERBOSE-}" != true ] || verbose() { printf %s\\n "${1-}"; }

die() {
  printf %s\\n "$1" >&2
  exit 1
}

trim() {
  # MWRAPPER-139:
  #   Trims trailing and leading whitespace, carriage returns, tabs, and linefeeds.
  #   Needed for removing poorly stripped 'InstallationPath' value in a multi-line
  #   temporary file generated by 'msiexec /x' during uninstallation of MsWinInstaller.
  printf "%s" "${1}" | tr -d '[:space:]'
}

# parse distributionUrl and optional distributionSha256Sum, wrapperUrl and optional wrapperSha256Sum
while IFS="=" read -r key value; do
  case "${key-}" in
  distributionUrl) distributionUrl=$(trim "${value-}") ;;
  distributionSha256Sum) distributionSha256Sum=$(trim "${value-}") ;;
  wrapperUrl) wrapperUrl=$(trim "${value-}") ;;
  wrapperSha256Sum) wrapperSha256Sum=$(trim "${value-}") ;;
  esac
done <"${0%/*}/.mvn/wrapper/maven-wrapper.properties"
[ -n "${distributionUrl-}" ] || die "cannot read distributionUrl property in ${0%/*}/.mvn/wrapper/maven-wrapper.properties"

case "${distributionUrl##*/}" in
apache-maven-*-bin.zip | apache-maven-*-bin.tar.gz) : ;;
*) die "distributionUrl is not valid, must match apache-maven-<version>-bin.zip|.tar.gz" ;;
esac

# apply MVNW_REPOURL and calculate MAVEN_HOME
# maven home pattern: ~/.m2/wrapper/dists/{apache-maven-<version>-bin}.{zip|tar.gz}/{hashcode}
# maven home pattern: ~/.m2/wrapper/dists/{apache-maven-<version>-bin}.{zip|tar.gz}/{hashcode}/{apache-maven-<version>}
distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
distributionUrlNameExt="${distributionUrlName##*.}"
if [ -z "${MVNW_REPOURL-}" ]; then
  distributionUrl="${distributionUrl}"
else
  distributionUrl="${MVNW_REPOURL}/org/apache/maven/apache-maven/${distributionUrlNameMain#apache-maven-}/${distributionUrlName}"
fi
distributionHash=$(hash_string "${distributionUrl}")

# HOME_DIR = user home dir (OS-independent)
if [ "${XDG_DATA_HOME-}" ]; then
  userHome="${XDG_DATA_HOME}"
elif [ "${HOME-}" ]; then
  userHome="${HOME}"
else
  userHome="$(
    cd ~
    pwd
  )"
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-${userHome}/.m2}"
MAVEN_HOME="${MAVEN_USER_HOME}/wrapper/dists/${distributionUrlNameMain}/${distributionHash}"
# The zip extracts to a directory without the '-bin' suffix (e.g. apache-maven-3.9.9/)
distributionDirName="${distributionUrlNameMain%-bin}"
MAVEN_EXEC="${MAVEN_HOME}/${distributionDirName}/bin/mvn"

verbose "Checking for Maven installation at: ${MAVEN_HOME}"

if [ -x "${MAVEN_EXEC}" ]; then
  verbose "Found Maven in ${MAVEN_EXEC}"
else
  verbose "Maven not found, downloading..."
  distZip="${MAVEN_HOME}/maven.${distributionUrlNameExt}"
  mkdir -p "${MAVEN_HOME}"

  # Download with curl or wget
  if command -v curl > /dev/null 2>&1; then
    curl -fL "${distributionUrl}" -o "${distZip}"
  elif command -v wget > /dev/null 2>&1; then
    wget "${distributionUrl}" -O "${distZip}"
  else
    die "Neither curl nor wget is available. Please install one and re-run."
  fi

  # Verify checksum if provided
  if [ -n "${distributionSha256Sum-}" ]; then
    if command -v sha256sum > /dev/null 2>&1; then
      echo "${distributionSha256Sum}  ${distZip}" | sha256sum --check --status || die "Downloaded Maven distribution failed SHA-256 checksum."
    fi
  fi

  # Extract
  case "${distributionUrlNameExt}" in
  zip)
    unzip -qo "${distZip}" -d "${MAVEN_HOME}"
    ;;
  tar.gz)
    tar -xzf "${distZip}" -C "${MAVEN_HOME}"
    ;;
  esac
  rm -f "${distZip}"
fi

set_java_home

exec "${MAVEN_EXEC}" "$@"
